<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Listing - Call2Buy Marketplace</title>
  <link rel="stylesheet" href="/css/basics.css" />
  <link rel="stylesheet" href="/css/nav.css" />
  <link rel="stylesheet" href="/css/form-styles.css" />
  <link rel="stylesheet" href="/css/footer.css" />
  <link rel="stylesheet" href="/css/all.min.css" />
  <link rel="stylesheet" href="/sell-item/style.css" />
</head>

<body>
  <nav>
    <div class="nav-con">
      <div class="logo">
        <a href="/home">Call<span class="brand-accent">2</span>Buy<span class="logo-dot"></span></a>
      </div>
      <div class="right-side">
        <input type="checkbox" id="bars" class="nav-checkbox" />
        <ul>
          <li>
            <a href="/home"><i class="fa-solid fa-house"></i> Home</a>
          </li>
          <li class="nav-sell">
            <a href="/sell-item"><i class="fa-solid fa-plus"></i> Sell Item</a>
          </li>
          <li id="nav-login">
            <a href="/login"><i class="fa-solid fa-arrow-right-to-bracket"></i> Login</a>
          </li>
          <li id="nav-register">
            <a href="/register"><i class="fa-solid fa-user-plus"></i> Register</a>
          </li>
          <li id="nav-username" style="display: none">
            <a href="/my-account"><i class="fa-solid fa-circle-user"></i> <span></span></a>
          </li>
          <li id="nav-logout" style="display: none">
            <a href="#"><i class="fa-solid fa-arrow-right-from-bracket"></i> Logout</a>
          </li>
        </ul>
        <button class="toggle-theme" aria-label="Toggle theme">
          <i class="fa-solid fa-sun"></i>
        </button>
        <label for="bars" class="bars-icon" aria-label="Open menu">
          <i class="fa-solid fa-bars"></i>
        </label>
      </div>
    </div>
  </nav>

  <main class="sell-container">
    <div class="sell-card">
      <div class="sell-header">
        <h1 class="sell-title">Edit Listing</h1>
        <p class="sell-subtitle">
          Update the price, description, or seller contact information for this listing.
        </p>
      </div>

      <form id="edit-form" autocomplete="off">
        <!-- Details Section -->
        <section class="form-section product-information">
          <div class="section-title-row">
            <h2><i class="fa-solid fa-file-lines"></i> Item Specifications</h2>
          </div>

          <div class="form-group product-title" id="same">
            <label for="title-input">Listing Title</label>
            <input
              type="text"
              class="input-proudct"
              id="title-input"
              value="<%= locals.title %>"
              required
            />
          </div>

          <div class="form-group product-discription" id="same">
            <div class="desc-label-row">
              <label for="textarea">Item Description</label>
              <button type="button" class="ai-btn" id="ai-btn">
                <i class="fa-solid fa-wand-magic-sparkles"></i> AI Refine
              </button>
            </div>
            <textarea
              id="textarea"
              class="input-proudct"
              rows="5"
              required
            ><%= locals.product_description %></textarea>
          </div>

          <div class="form-row-2col">
            <div class="form-group product-Category" id="same">
              <label for="select-category">Category</label>
              <select class="input-proudct" id="select-category" data-default="<%= locals.categories[0] %>" required>
                <option value="" disabled>Select category</option>
                <% dbCategories.forEach(category => { %>
                  <option value="<%= category %>"><%= category %></option>
                <% }); %>
              </select>
            </div>

            <div class="form-group product-condition" id="same">
              <label for="select-condition">Condition</label>
              <select class="input-proudct" id="select-condition" data-default="<%= locals.condition %>" required>
                <option value="" disabled>Select condition</option>
                <option value="New">New (Unopened / Boxed)</option>
                <option value="Used-like New">Used - Like New (Flawless)</option>
                <option value="Used-Good">Used - Good (Minor wear)</option>
                <option value="Used - Acceptable">Used - Acceptable (Functional)</option>
                <option value="For Parts or Not Working">For Parts or Repair</option>
              </select>
            </div>
          </div>

          <div class="form-group product-price" id="same">
            <label for="price-input">Asking Price ($ USD)</label>
            <input
              value="<%= locals.price %>"
              type="number"
              step="0.01"
              min="0"
              class="input-proudct"
              id="price-input"
              required
            />
          </div>
        </section>

        <!-- Contact Section -->
        <section class="form-section Seller-Contact-Information">
          <div class="section-title-row">
            <h2><i class="fa-solid fa-address-book"></i> Seller Contact Details</h2>
          </div>

          <div class="form-row-2col">
            <div class="form-group address" id="same">
              <label for="address-input">Location / City</label>
              <input
                value="<%= locals.product_address %>"
                type="text"
                class="input-proudct"
                id="address-input"
                required
              />
            </div>

            <div class="form-group phone-num" id="same">
              <label for="phone-input">Contact Phone Number</label>
              <input
                value="<%= locals.phone %>"
                type="tel"
                class="input-proudct"
                id="phone-input"
                required
              />
            </div>
          </div>
        </section>

        <div class="form-actions">
          <button type="submit" class="submit-btn" id="list-product-btn">
            <i class="fa-solid fa-check"></i> Save Listing Changes
          </button>
        </div>
      </form>
    </div>
  </main>

  <footer>
    <div class="footer-content">
      <div class="footer-links">
        <a href="/home">Marketplace</a>
        <a href="#">Safety Guidelines</a>
        <a href="#">Terms of Service</a>
        <a href="#">Privacy Policy</a>
      </div>
      <div class="footer-social">
        <a href="https://github.com/Abbas49/Web-Project" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub">
          <i class="fa-brands fa-github"></i>
        </a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2025 Call2Buy. Direct-contact secondhand marketplace.</p>
    </div>
  </footer>

  <script src="/js/toggle-theme.js"></script>
  <script src="/js/nav.js"></script>
  <script src="/sell-item/selectDefault.js"></script>
  <script src="/sell-item/script.js"></script>
  <script src="/sell-item/editProduct.js"></script>
</body>
</html>